# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env al repositorio.

# Llave maestra de la Agencia. Todos los endpoints de escritura la requieren.
AGENCIA_API_KEY=tu_clave_secreta_aqui

# URL de la API pública externa usada en GET /briefing/{nombre}.
# Por defecto: Advice Slip API (sin autenticación).
EXTERNAL_API_URL=https://api.adviceslip.com/advice
